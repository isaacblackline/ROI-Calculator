<script>
(function () {
  'use strict';

  var currentCurrency = 'CAD';

  var currencyInfoMap = {
    CAD: { code: 'CAD', symbol: '$' },
    USD: { code: 'USD', symbol: '$' },
    EUR: { code: 'EUR', symbol: '€' },
    GBP: { code: 'GBP', symbol: '£' },
    AUD: { code: 'AUD', symbol: '$' }
  };

  function getCurrencyInfo() {
    return currencyInfoMap[currentCurrency] || currencyInfoMap.CAD;
  }

  function updateCurrencyLabels() {
    var code = currentCurrency;

    var hourlyText = document.getElementById('label_hourly_cost_text');
    if (hourlyText) hourlyText.textContent = 'Average hourly labour cost (' + code + '/hr)';

    var radioText = document.getElementById('label_cost_radio_text');
    if (radioText) radioText.textContent = 'Annual price of one radio and any associated subscription (' + code + ')';

    var detectorText = document.getElementById('label_cost_legacy_detector_text');
    if (detectorText) detectorText.textContent = 'Annual price of one portable gas detector and any associated subscription (' + code + ')';

    var lwText = document.getElementById('label_cost_lone_worker_text');
    if (lwText) lwText.textContent = 'Annual price of one lone worker device or app and any associated subscription (' + code + ')';

    var label = document.getElementById('label_gas_savings');
    if (label) label.textContent = 'Calibration gas savings per device per year (' + code + ')';

    label = document.getElementById('label_addon_ptt');
    if (label) label.textContent = 'Push-to-Talk add-on per device (annual, ' + code + ')';

    label = document.getElementById('label_addon_monitoring');
    if (label) label.textContent = 'Blackline Safety Monitoring (24/7 by expert team) per device (annual, ' + code + ')';

    label = document.getElementById('label_addon_emergency_voice');
    if (label) label.textContent = 'Emergency Voice per device (annual, ' + code + ')';
  }

  function parseNumber(id) {
    var el = document.getElementById(id);
    if (!el) return 0;
    var raw = String(el.value).replace(/,/g, '').trim();
    var n = parseFloat(raw);
    return isNaN(n) ? 0 : n;
  }

  function formatCurrency(value) {
    var info = getCurrencyInfo();
    return info.symbol + value.toLocaleString(undefined, { maximumFractionDigits: 0 }) + ' ' + info.code;
  }

  function formatPercent(value) {
    return (value * 100).toLocaleString(undefined, { maximumFractionDigits: 1 }) + '%';
  }

  function formatMonths(value) {
    return value.toLocaleString(undefined, { maximumFractionDigits: 1 });
  }

  function setText(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function recalc() {
    var B6  = parseNumber('num_workers');
    var B7  = parseNumber('hourly_cost');
    var B8  = parseNumber('cost_radio');
    var B9  = parseNumber('cost_legacy_detector');
    var B10 = parseNumber('hardware_cost');
    var B11 = parseNumber('subscription_cost');
    var B12 = parseNumber('cost_lone_worker');
    var B13 = parseNumber('workdays_per_year');
    var B14 = parseNumber('weeks_per_year');
    var otherCosts = parseNumber('other_annual_costs');

    var addonPTT = parseNumber('addon_ptt');
    var addonMonitoring = parseNumber('addon_monitoring');
    var addonEmergencyVoice = parseNumber('addon_emergency_voice');

    var scenarios = {
      conservative: {
        minutesPerDay: parseNumber('minutes_saved_conservative'),
        adoption:      parseNumber('adoption_conservative'),
        adminHours:    parseNumber('admin_hours_conservative'),
        gasSavings:    parseNumber('gas_savings_conservative')
      },
      typical: {
        minutesPerDay: parseNumber('minutes_saved_typical'),
        adoption:      parseNumber('adoption_typical'),
        adminHours:    parseNumber('admin_hours_typical'),
        gasSavings:    parseNumber('gas_savings_typical')
      },
      high: {
        minutesPerDay: parseNumber('minutes_saved_high'),
        adoption:      parseNumber('adoption_high'),
        adminHours:    parseNumber('admin_hours_high'),
        gasSavings:    parseNumber('gas_savings_high')
      }
    };

    var g8RecurringPerDevice = B11 + addonPTT + addonMonitoring + addonEmergencyVoice;
    var deviceConsolidationPerDevice = (B8 + B9 + B12) - g8RecurringPerDevice;
    var deviceConsolidation = B6 * deviceConsolidationPerDevice;

    var totalYear1G8Cost = B6 * (B10 + B11 + addonPTT + addonMonitoring + addonEmergencyVoice) + otherCosts;

    Object.keys(scenarios).forEach(function (key) {
      var s = scenarios[key];

      var workerTimeSavings = B6 * (s.minutesPerDay / 60) * B13 * s.adoption * B7;
      var adminSavings = B6 * s.adminHours * B14 * B7;
      var gasSavings = B6 * s.gasSavings;

      var totalSavings = workerTimeSavings + adminSavings + gasSavings + deviceConsolidation;

      var roi = totalYear1G8Cost === 0 ? 0 : totalSavings / totalYear1G8Cost;
      var payback = totalSavings === 0 ? 0 : (12 * totalYear1G8Cost / totalSavings);

      var suffix = '_' + key;

      setText('workerTime' + suffix,    formatCurrency(workerTimeSavings));
      setText('adminSavings' + suffix,  formatCurrency(adminSavings));
      setText('gasSavings' + suffix,    formatCurrency(gasSavings));
      setText('deviceSavings' + suffix, formatCurrency(deviceConsolidation));
      setText('totalSavings' + suffix,  formatCurrency(totalSavings));
      setText('totalCost' + suffix,     formatCurrency(totalYear1G8Cost));
      setText('roi' + suffix,           formatPercent(roi));
      setText('payback' + suffix,       formatMonths(payback));
    });
  }

  // Registry so only one popover can be open at a time
  var popoverRegistry = [];

  function closeAllPopovers(exceptPopoverEl) {
    popoverRegistry.forEach(function (item) {
      if (item.pop !== exceptPopoverEl) {
        item.pop.setAttribute('aria-hidden', 'true');
        item.btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function setupPopover(btnId, popoverId) {
    var btn = document.getElementById(btnId);
    var pop = document.getElementById(popoverId);
    if (!btn || !pop) return;

    popoverRegistry.push({ btn: btn, pop: pop });

    function closePopover() {
      pop.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
    }

    function openPopover() {
      closeAllPopovers(pop);
      pop.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
    }

    function togglePopover() {
      var isHidden = pop.getAttribute('aria-hidden') !== 'false';
      if (isHidden) openPopover();
      else closePopover();
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      togglePopover();
    });

    document.addEventListener('click', function (e) {
      if (!pop.contains(e.target) && e.target !== btn) closePopover();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePopover();
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    var baselineValues = {};

    var inputs = document.querySelectorAll('input');
    inputs.forEach(function (input) {
      if (input.id) baselineValues[input.id] = input.value;
      input.addEventListener('input', recalc);
      input.addEventListener('change', recalc);
    });

    var resetBtn = document.getElementById('reset_baseline_btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        Object.keys(baselineValues).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.value = baselineValues[id];
        });
        recalc();
      });
    }

    var currencySelect = document.getElementById('currency_select');
    if (currencySelect) {
      currentCurrency = currencySelect.value || 'CAD';
      currencySelect.addEventListener('change', function () {
        currentCurrency = this.value || 'CAD';
        updateCurrencyLabels();
        recalc();
      });
    }

    // Popovers
    setupPopover('currency_info_btn', 'currency_info_popover');
    setupPopover('num_workers_info_btn', 'num_workers_info_popover');
    setupPopover('hourly_cost_info_btn', 'hourly_cost_info_popover');
    setupPopover('radio_info_btn', 'radio_info_popover');
    setupPopover('detector_info_btn', 'detector_info_popover');
    setupPopover('lw_info_btn', 'lw_info_popover');
    setupPopover('g8_hw_info_btn', 'g8_hw_info_popover');
    setupPopover('g8_plan_info_btn', 'g8_plan_info_popover');
    setupPopover('other_costs_info_btn', 'other_costs_info_popover');

    updateCurrencyLabels();
    recalc();
  });
})();
</script>
</body>
</html>
