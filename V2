<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>G8 ROI Calculator</title>
  <style>
    :root {
      font-family: "Calibre", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.4;
      color: #101820; /* Blackline Black */
    }

    body {
      margin: 0;
      padding: 1.5rem;
      background: #f2f3f5;
    }

    .roi-calculator {
      max-width: 960px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 4px;
      padding: 0 2rem 1.75rem 2rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
      border-top: 4px solid #A6192E; /* Safety Red accent bar */
      overflow: hidden;
    }

    /* Brand bar: logo on white background */
    .roi-brand-bar {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding: 0.75rem 2rem;
      margin: 0 -2rem;
      background: #ffffff;
      border-bottom: 1px solid #e2e4e7;
    }

    .roi-logo {
      height: 36px;
      width: auto;
      display: block;
    }

    /* Title bar: white text on black */
    .roi-title-bar {
      margin: 0 -2rem 1.5rem -2rem;
      padding: 0.9rem 2rem;
      background: #101820; /* Blackline Black */
      color: #ffffff;
    }

    .roi-title-bar h1 {
      margin: 0;
      font-size: 1.6rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      font-weight: 600;
    }

    .roi-calculator p.intro {
      font-size: 0.95rem;
      color: #333;
      margin-bottom: 1.25rem;
      background: #f8f5f6;
      border-left: 4px solid #A6192E;
      padding: 0.75rem 0.75rem;
      border-radius: 3px;
    }

    .roi-calculator h2 {
      font-size: 1.05rem;
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: 3px;
      background: #f8f5f6;
      border-left: 4px solid #A6192E;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 700;
    }

    .section-note {
      font-size: 0.85rem;
      color: #555;
      margin-bottom: 0.5rem;
    }

    .section-card {
      background: #f7f8fa;
      border-radius: 4px;
      padding: 0.75rem 0.9rem 0.9rem 0.9rem;
      margin-bottom: 0.75rem;
      border: 1px solid #e0e2e6;
    }

    .inputs-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 0.5rem 1rem;
      align-items: center;
    }

    /* Label + icon wrapper */
    .label-with-info {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .inputs-grid label {
      font-size: 0.9rem;
    }

    .inputs-grid input {
      width: 100%;
      padding: 0.4rem 0.45rem;
      border-radius: 3px;
      border: 1px solid #c5c9cf;
      font-size: 0.9rem;
      box-sizing: border-box;
      color: #101820;
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }

    .inputs-grid input.green-input {
      background: #f2f5fa;
      border-left: 3px solid #A6192E;
    }

    .inputs-grid input.orange-input,
    .scenario-table input.orange-input {
      background: #fdf3f4;
      border-left: 3px solid #A6192E;
    }

    .inputs-grid input:focus,
    .scenario-table input:focus {
      outline: none;
      border-color: #101820;
      box-shadow: 0 0 0 1px rgba(16, 24, 32, 0.25);
      background-color: #ffffff;
    }

    .scenario-table,
    .results-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }

    .scenario-table th,
    .scenario-table td,
    .results-table th,
    .results-table td {
      border: 1px solid #dde1e6;
      padding: 0.35rem 0.5rem;
      text-align: right;
    }

    .scenario-table th:first-child,
    .scenario-table td:first-child,
    .results-table th:first-child,
    .results-table td:first-child {
      text-align: left;
      white-space: nowrap;
    }

    .scenario-table thead th,
    .results-table thead th {
      background: #fbe9ec;
      font-weight: 600;
    }

    .scenario-table tbody tr:nth-child(even) {
      background: #fafbfc;
    }

    .results-table tbody tr:nth-child(even) {
      background: #fafafa;
    }

    .results-table .highlight-row {
      background: #fdecee;
      font-weight: 700;
      border-left: 3px solid #A6192E;
    }

    .small-text {
      font-size: 0.8rem;
      color: #666;
      margin-top: 0.75rem;
    }

    /* Reset button styles */
    .reset-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }

    #reset_baseline_btn {
      padding: 0.4rem 0.75rem;
      border-radius: 3px;
      border: 1px solid #A6192E;
      background: #ffffff;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    #reset_baseline_btn:hover {
      background: #fbe9ec;
    }

    .reset-help {
      color: #555;
    }

    /* Currency row styles */
    .currency-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      font-size: 0.9rem;
      flex-wrap: wrap;
      position: relative;
    }

    .currency-row label {
      font-weight: 600;
    }

    .currency-row select {
      padding: 0.3rem 0.6rem;
      border-radius: 3px;
      border: 1px solid #c5c9cf;
      font-size: 0.9rem;
      background: #ffffff;
    }

    /* Info icon + popover */
    .info-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .info-icon-btn {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid #c5c9cf;
      background: #ffffff;
      color: #101820;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      line-height: 1;
      font-weight: 800;
      font-size: 0.9rem;
      user-select: none;
      transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .info-icon-btn:hover {
      background: #fbe9ec;
      border-color: #A6192E;
    }

    .info-icon-btn:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(16, 24, 32, 0.18);
      border-color: #101820;
    }

    /* Popover anchors to the right of the icon */
    .info-popover {
      position: absolute;
      top: 50%;
      left: calc(100% + 10px);
      right: auto;
      transform: translateY(-50%);
      width: 360px;
      max-width: calc(100vw - 48px);
      background: #ffffff;
      border: 1px solid #e0e2e6;
      border-radius: 4px;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
      padding: 0.8rem 0.9rem;
      z-index: 50;
      display: none;
    }

    .info-popover[aria-hidden="false"] {
      display: block;
    }

    .info-popover::before {
      content: "";
      position: absolute;
      left: -7px;
      top: 50%;
      transform: translateY(-50%) rotate(45deg);
      width: 12px;
      height: 12px;
      background: #ffffff;
      border-left: 1px solid #e0e2e6;
      border-bottom: 1px solid #e0e2e6;
    }

    /* Popover content: stacked heading + body */
    .popover-section {
      margin-bottom: 0.55rem;
    }
    .popover-section:last-child {
      margin-bottom: 0;
    }

    .info-popover .popover-title {
      font-size: 11px;
      font-weight: 700;
      color: #101820;
      margin: 0 0 0.2rem 0;
    }

    .info-popover .popover-body {
      font-size: 11px;
      line-height: 1.35;
      color: #333;
      margin: 0;
    }

    /* Explainer blocks below the results table */
    .explainer-row {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      flex-wrap: nowrap;
    }

    .explainer-card {
      flex: 1;
      background: #f7f8fa;
      border-radius: 4px;
      border: 1px solid #e0e2e6;
      padding: 0.75rem 0.9rem;
      font-size: 0.85rem;
    }

    .explainer-card h3 {
      margin: 0 0 0.35rem 0;
      font-size: 0.95rem;
      font-weight: 600;
    }

    .explainer-card p {
      margin: 0 0 0.35rem 0;
      font-weight: 500;
    }

    .explainer-list {
      margin: 0 0 0 1.1rem;
      padding: 0;
    }

    .explainer-list li {
      margin-bottom: 0.2rem;
    }

    @media (max-width: 720px) {
      .roi-calculator {
        padding: 0 1rem 1.25rem 1rem;
      }

      .roi-brand-bar {
        padding: 0.75rem 1rem;
        margin: 0 -1rem;
      }

      .roi-title-bar {
        padding: 0.9rem 1rem;
        margin: 0 -1rem 1.25rem -1rem;
      }

      .roi-title-bar h1 {
        font-size: 1.3rem;
      }

      .inputs-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .scenario-table,
      .results-table {
        font-size: 0.8rem;
      }

      .reset-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .currency-row {
        flex-direction: column;
        align-items: flex-start;
      }

      /* On mobile: fall back to below so it doesn't overflow */
      .info-popover {
        top: calc(100% + 10px);
        left: 0;
        transform: none;
        width: 100%;
      }

      .info-popover::before {
        left: 10px;
        top: -7px;
        transform: rotate(45deg);
        border-left: 1px solid #e0e2e6;
        border-bottom: none;
        border-top: 1px solid #e0e2e6;
      }

      .explainer-row {
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
<div class="roi-calculator">
  <!-- Brand logo on white background -->
  <div class="roi-brand-bar">
    <img
      src="https://www.blacklinesafety.com/hubfs/Blacklinesafety_2021/images/Logo_color.svg"
      alt="Blackline Safety logo"
      class="roi-logo"
    >
  </div>

  <!-- Title bar with white text on black -->
  <div class="roi-title-bar">
    <h1>G8 ROI Calculator</h1>
  </div>

  <p class="intro">
    <strong>Measure your savings</strong><br>
    Enter a few values to start. Every field is flexible and can be changed anytime. We'll show savings, Year&nbsp;1 ROI,
    and payback across conservative, typical, and high-value scenarios.
  </p>

  <!-- Reset to baseline values -->
  <div class="reset-row">
    <button type="button" id="reset_baseline_btn">Reset to baseline values</button>
    <span class="reset-help">
      Resets all inputs back to the original baseline values shown when the calculator first loaded.
    </span>
  </div>

  <!-- Currency selector -->
  <div class="currency-row">
    <label for="currency_select">Currency:</label>
    <select id="currency_select">
      <option value="CAD" selected>CAD (Canadian Dollar)</option>
      <option value="USD">USD (US Dollar)</option>
      <option value="EUR">EUR (Euro)</option>
      <option value="GBP">GBP (Pound Sterling)</option>
      <option value="AUD">AUD (Australian Dollar)</option>
    </select>

    <span class="info-wrap">
      <button
        type="button"
        class="info-icon-btn"
        id="currency_info_btn"
        aria-label="Pricing and currency information"
        aria-expanded="false"
        aria-controls="currency_info_popover"
      >
        &#9432;
      </button>

      <div class="info-popover" id="currency_info_popover" role="dialog" aria-hidden="true">
        <div class="popover-section">
          <div class="popover-title">Currency handling</div>
          <p class="popover-body">All monetary inputs and results are treated as being in the selected currency. No exchange-rate conversion is applied.</p>
        </div>
        <div class="popover-section">
          <div class="popover-title">Pricing source and purchase method</div>
          <p class="popover-body">The ROI calculator works irrespective of purchase method, including lease or purchase. Always pull G8 pricing from the price list and enter the applicable full-year values into the relevant fields.</p>
        </div>
      </div>
    </span>
  </div>

  <!-- Customer Inputs -->
  <h2>Customer Inputs</h2>
  <div class="section-card">
    <div class="section-note">Edit the fields below to reflect your deployment.</div>

    <div class="inputs-grid">
      <!-- Number of devices: popover -->
      <label for="num_workers" id="label_num_workers">
        <span class="label-with-info">
          Number of devices to be replaced/purchased
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="num_workers_info_btn"
              aria-label="Number of devices information"
              aria-expanded="false"
              aria-controls="num_workers_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="num_workers_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Number of devices to be replaced or purchased</div>
                <p class="popover-body">
                  The number of devices the customer plans to buy. It is assumed the customer will replace the same quantity
                  of devices for gas detection, radio communication, and lone worker.
                </p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="num_workers" value="100" min="0" step="1">

      <!-- Average hourly labour cost: popover -->
      <label for="hourly_cost" id="label_hourly_cost">
        <span class="label-with-info">
          <span id="label_hourly_cost_text">Average hourly labour cost (CAD/hr)</span>
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="hourly_cost_info_btn"
              aria-label="Average hourly labour cost information"
              aria-expanded="false"
              aria-controls="hourly_cost_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="hourly_cost_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Average hourly labor cost</div>
                <p class="popover-body">
                  The estimated hourly cost of a field worker, based on wages or salary.
                </p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="hourly_cost" value="55" min="0" step="0.01">

      <!-- Radio (Option B) -->
      <label for="cost_radio" id="label_cost_radio">
        <span class="label-with-info">
          <span id="label_cost_radio_text">Annual price of one radio and any associated subscription (CAD)</span>
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="radio_info_btn"
              aria-label="Radio pricing information"
              aria-expanded="false"
              aria-controls="radio_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="radio_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Baseline</div>
                <p class="popover-body">Motorola DP4801 EX</p>
              </div>
              <div class="popover-section">
                <div class="popover-title">Update for customer</div>
                <p class="popover-body">Replace with the customer’s current radio + subscription price.</p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="cost_radio" value="2950" min="0" step="0.01">

      <!-- Portable gas detector (Option B) -->
      <label for="cost_legacy_detector" id="label_cost_legacy_detector">
        <span class="label-with-info">
          <span id="label_cost_legacy_detector_text">Annual price of one portable gas detector and any associated subscription (CAD)</span>
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="detector_info_btn"
              aria-label="Portable gas detector pricing information"
              aria-expanded="false"
              aria-controls="detector_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="detector_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Baseline</div>
                <p class="popover-body">MSA Altair io4 + Complete Service Plan</p>
              </div>
              <div class="popover-section">
                <div class="popover-title">Update for customer</div>
                <p class="popover-body">Change the price here to reflect the customer's gas detector.</p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="cost_legacy_detector" value="1152" min="0" step="0.01">

      <!-- Lone worker (Option B) -->
      <label for="cost_lone_worker" id="label_cost_lone_worker">
        <span class="label-with-info">
          <span id="label_cost_lone_worker_text">Annual price of one lone worker device or app and any associated subscription (CAD)</span>
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="lw_info_btn"
              aria-label="Lone worker pricing information"
              aria-expanded="false"
              aria-controls="lw_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="lw_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Baseline</div>
                <p class="popover-body">Twig Neo</p>
              </div>
              <div class="popover-section">
                <div class="popover-title">Update for customer</div>
                <p class="popover-body">Change the price to reflect the customer's lone worker device or app.</p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="cost_lone_worker" value="700" min="0" step="0.01">

      <!-- G8 hardware (Option A) -->
      <label for="hardware_cost">
        <span class="label-with-info">
          G8 hardware price per device
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="g8_hw_info_btn"
              aria-label="G8 hardware configuration information"
              aria-expanded="false"
              aria-controls="g8_hw_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="g8_hw_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Pricing guidance</div>
                <p class="popover-body">Default configuration is set as 4 gas sensor (H2S, LEL MPS, CO and O2) on a 2 year warranty</p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="hardware_cost" value="994" min="0" step="0.01">

      <!-- G8 service plan (Option A) -->
      <label for="subscription_cost">
        <span class="label-with-info">
          G8 annual service plan price per device
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="g8_plan_info_btn"
              aria-label="G8 service plan information"
              aria-expanded="false"
              aria-controls="g8_plan_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="g8_plan_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Pricing guidance</div>
                <p class="popover-body">This is set as PRO service plan</p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="subscription_cost" value="384" min="0" step="0.01">
    </div>

    <p class="small-text">
      Assumption:<br>
      Assumes G8 replaces a radio, a portable gas detector, and any lone worker device or app for each device purchased.
    </p>
  </div>

  <!-- Add-on Features / Other Costs -->
  <h2>Add-on Features/Other Costs</h2>
  <div class="section-card">
    <div class="section-note">
      Optional annual add-ons and other G8-related costs.
    </div>
    <div class="inputs-grid">
      <label for="addon_ptt" id="label_addon_ptt">Push-to-Talk add-on per device (annual, CAD)</label>
      <input class="green-input" type="number" id="addon_ptt" value="228" min="0" step="0.01">

      <label for="addon_monitoring" id="label_addon_monitoring">
        Blackline Safety Monitoring (24/7 by expert team) per device (annual, CAD)
      </label>
      <input class="green-input" type="number" id="addon_monitoring" value="276" min="0" step="0.01">

      <label for="addon_emergency_voice" id="label_addon_emergency_voice">
        Emergency Voice per device (annual, CAD)
      </label>
      <input class="green-input" type="number" id="addon_emergency_voice" value="300" min="0" step="0.01">

      <!-- MOVED: Other costs (with popover) -->
      <label for="other_annual_costs" id="label_other_annual_costs">
        <span class="label-with-info">
          Other costs
          <span class="info-wrap">
            <button
              type="button"
              class="info-icon-btn"
              id="other_costs_info_btn"
              aria-label="Other costs information"
              aria-expanded="false"
              aria-controls="other_costs_info_popover"
            >&#9432;</button>
            <div class="info-popover" id="other_costs_info_popover" role="dialog" aria-hidden="true">
              <div class="popover-section">
                <div class="popover-title">Other costs</div>
                <p class="popover-body">
                  In this field, include any additional G8 related costs such as implementation, training, extended warranty,
                  extra cartridges, or other add-ons.
                </p>
              </div>
            </div>
          </span>
        </span>
      </label>
      <input class="green-input" type="number" id="other_annual_costs" value="0" min="0" step="1">
    </div>
  </div>

  <!-- General Assumptions -->
  <h2>General Assumptions</h2>
  <div class="section-card">
    <div class="section-note">
      These are editable if your operation uses different values.
    </div>
    <div class="inputs-grid">
      <label for="workdays_per_year">Workdays per year</label>
      <input class="green-input" type="number" id="workdays_per_year" value="220" min="0" step="1">

      <label for="weeks_per_year">Weeks per year</label>
      <input class="green-input" type="number" id="weeks_per_year" value="52" min="0" step="1">
    </div>
  </div>

  <!-- Scenario Assumptions -->
  <h2>Scenario Assumptions</h2>
  <div class="section-card">
    <div class="section-note">
      Adjust the assumptions (right-hand columns) to reflect conservative, typical, and high-value outcomes.
    </div>

    <table class="scenario-table">
      <thead>
      <tr>
        <th>Assumption</th>
