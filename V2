<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>G8 ROI Calculator</title>

  <!-- Heebo font (Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      font-family: "Heebo", -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.45;
      color: #101820;
      --bl-red: #A6192E;
      --track-bg: #e7eaef;
    }

    input, select, button, textarea { font-family: inherit; }

    body { margin: 0; padding: 1.5rem; background: #f2f3f5; }

    .roi-calculator {
      max-width: 960px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 4px;
      padding: 0 2rem 1.75rem 2rem;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
      border-top: 4px solid var(--bl-red);
      overflow: hidden;
    }

    .roi-brand-bar {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding: 0.75rem 2rem;
      margin: 0 -2rem;
      background: #ffffff;
      border-bottom: 1px solid #e2e4e7;
    }

    .roi-logo { height: 36px; width: auto; display: block; }

    .roi-title-bar {
      margin: 0 -2rem 1.5rem -2rem;
      padding: 0.9rem 2rem;
      background: #101820;
      color: #ffffff;
    }

    .roi-title-bar h1 {
      margin: 0;
      font-size: 1.5rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .roi-calculator p.intro {
      font-size: 0.95rem;
      color: #333;
      margin-bottom: 1.25rem;
      background: #f8f5f6;
      border-left: 4px solid var(--bl-red);
      padding: 0.75rem;
      border-radius: 3px;
    }

    .roi-calculator h2 {
      font-size: 1.02rem;
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;
      padding: 0.5rem 0.75rem;
      border-radius: 3px;
      background: #f8f5f6;
      border-left: 4px solid var(--bl-red);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 800;
    }

    .section-note { font-size: 0.85rem; color: #555; margin-bottom: 0.5rem; }

    .section-card {
      background: #f7f8fa;
      border-radius: 4px;
      padding: 0.75rem 0.9rem 0.9rem 0.9rem;
      margin-bottom: 0.75rem;
      border: 1px solid #e0e2e6;
    }

    .inputs-grid {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 0.5rem 1rem;
      align-items: center;
    }

    .label-with-info {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .inputs-grid label { font-size: 0.9rem; }

    .inputs-grid input[type="number"] {
      width: 100%;
      padding: 0.4rem 0.45rem;
      border-radius: 3px;
      border: 1px solid #c5c9cf;
      font-size: 0.9rem;
      box-sizing: border-box;
      color: #101820;
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
    }

    .inputs-grid input.green-input { background: #f2f5fa; border-left: 3px solid var(--bl-red); }

    .inputs-grid input.orange-input,
    .scenario-table input.orange-input {
      background: #fdf3f4;
      border-left: 3px solid var(--bl-red);
    }

    .inputs-grid input:focus,
    .scenario-table input:focus {
      outline: none;
      border-color: #101820;
      box-shadow: 0 0 0 1px rgba(16, 24, 32, 0.25);
      background-color: #ffffff;
    }

    .scenario-table,
    .results-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin-top: 0.5rem;
    }

    .scenario-table th,
    .scenario-table td,
    .results-table th,
    .results-table td {
      border: 1px solid #dde1e6;
      padding: 0.35rem 0.5rem;
      text-align: right;
      vertical-align: top;
    }

    .scenario-table th:first-child { text-align: left; white-space: nowrap; }
    .scenario-table td:first-child { text-align: left; white-space: normal; }

    .results-table th:first-child,
    .results-table td:first-child { text-align: left; white-space: nowrap; }

    .scenario-table thead th,
    .results-table thead th { background: #fbe9ec; font-weight: 700; }

    .scenario-table tbody tr:nth-child(even) { background: #fafbfc; }
    .results-table tbody tr:nth-child(even) { background: #fafafa; }

    .results-table .highlight-row {
      background: #fdecee;
      font-weight: 800;
      border-left: 3px solid var(--bl-red);
    }

    .small-text { font-size: 0.8rem; color: #666; margin-top: 0.75rem; }

    .reset-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }

    #reset_baseline_btn {
      padding: 0.4rem 0.75rem;
      border-radius: 3px;
      border: 1px solid var(--bl-red);
      background: #ffffff;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    #reset_baseline_btn:hover { background: #fbe9ec; }
    .reset-help { color: #555; }

    .currency-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
      flex-wrap: wrap;
      position: relative;
    }

    .currency-row label { font-weight: 700; }

    .currency-row select {
      padding: 0.3rem 0.6rem;
      border-radius: 3px;
      border: 1px solid #c5c9cf;
      font-size: 0.9rem;
      background: #ffffff;
    }

    .currency-helper {
      font-size: 0.85rem;
      color: #555;
      margin: 0 0 1rem 0;
      line-height: 1.35;
    }

    .info-wrap { position: relative; display: inline-flex; align-items: center; }

    .info-icon-btn {
      width: 16px;
      height: 16px;
      border-radius: 999px;
      border: 1px solid #c5c9cf;
      background: #ffffff;
      color: #101820;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      user-select: none;
      transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .info-icon-btn:hover { background: #fbe9ec; border-color: var(--bl-red); }

    .info-icon-btn:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(16, 24, 32, 0.18);
      border-color: #101820;
    }

    .info-icon-btn .info-glyph {
      display: block;
      line-height: 1;
      font-size: 11px;
      font-weight: 700;
      font-style: italic;
      transform: translateY(-0.5px) skew(-10deg);
    }

    .info-popover {
      position: absolute;
      top: 50%;
      left: calc(100% + 10px);
      transform: translateY(-50%);
      width: 440px;
      max-width: min(520px, calc(100vw - 48px));
      max-height: 60vh;
      overflow: auto;

      background: #ffffff;
      border: 1px solid #e0e2e6;
      border-radius: 4px;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
      padding: 1rem 1.05rem;
      z-index: 50;
      display: none;

      white-space: normal;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .info-popover[aria-hidden="false"] { display: block; }

    .info-popover::before {
      content: "";
      position: absolute;
      left: -7px;
      top: 50%;
      transform: translateY(-50%) rotate(45deg);
      width: 12px;
      height: 12px;
      background: #ffffff;
      border-left: 1px solid #e0e2e6;
      border-bottom: 1px solid #e0e2e6;
    }

    .popover-section { margin-bottom: 0.75rem; }
    .popover-section:last-child { margin-bottom: 0; }

    .info-popover .popover-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--bl-red);
      margin: 0 0 0.35rem 0;
      letter-spacing: 0.01em;
    }

    .info-popover .popover-body {
      font-size: 0.9rem;
      line-height: 1.45;
      color: #333;
      margin: 0;
    }

    .tip-inline {
      display: block;
      margin-top: 0.35rem;
      font-size: 0.8rem;
      color: #555;
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: break-word;
      max-width: 100%;
    }

    .result-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: nowrap;
    }

    /* ─────────────────────────────────────────────
       Coverage sliders
       - step: 5
       - shows % value
       - track fill moves with thumb (gradient)
       - thumb is a red circle in Blackline red
       ───────────────────────────────────────────── */

    .slider-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
    }

    .slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: var(--track-bg);
      outline: none;
      border: 1px solid #c5c9cf;
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.06);
    }

    /* WebKit thumb */
    .slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--bl-red);
      border: 2px solid #ffffff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.18);
      cursor: pointer;
    }

    /* Firefox thumb */
    .slider::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--bl-red);
      border: 2px solid #ffffff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.18);
      cursor: pointer;
    }

    .slider:focus {
      box-shadow:
        inset 0 1px 2px rgba(0,0,0,0.06),
        0 0 0 2px rgba(16, 24, 32, 0.18);
      border-color: #101820;
    }

    .slider-value {
      min-width: 52px;
      text-align: right;
      font-weight: 800;
      color: #101820;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    /* Disclaimer button + panel */
    .disclaimer-row {
      margin-top: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .disclaimer-btn {
      align-self: flex-start;
      padding: 0.35rem 0.65rem;
      border-radius: 999px;
      border: 1px solid #c5c9cf;
      background: #ffffff;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 700;
      color: #101820;
    }

    .disclaimer-btn:hover { background: #fbe9ec; border-color: var(--bl-red); }

    .disclaimer-btn:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(16, 24, 32, 0.18);
      border-color: #101820;
    }

    .disclaimer-panel {
      background: #f7f8fa;
      border: 1px solid #e0e2e6;
      border-radius: 4px;
      padding: 0.6rem 0.7rem;
    }

    @media (max-width: 720px) {
      .roi-calculator { padding: 0 1rem 1.25rem 1rem; }
      .roi-brand-bar { padding: 0.75rem 1rem; margin: 0 -1rem; }
      .roi-title-bar { padding: 0.9rem 1rem; margin: 0 -1rem 1.25rem -1rem; }
      .roi-title-bar h1 { font-size: 1.25rem; }
      .inputs-grid { grid-template-columns: minmax(0, 1fr); }
      .scenario-table, .results-table { font-size: 0.8rem; }
      .reset-row { flex-direction: column; align-items: flex-start; }
      .currency-row { flex-direction: column; align-items: flex-start; }

      .info-popover {
        top: calc(100% + 10px);
        left: 0;
        transform: none;
        width: 100%;
        max-width: 100%;
      }

      .info-popover::before {
        left: 10px;
        top: -7px;
        transform: rotate(45deg);
        border-left: 1px solid #e0e2e6;
        border-bottom: none;
        border-top: 1px solid #e0e2e6;
      }
    }
  </style>
</head>

<body>
  <div class="roi-calculator">
    <div class="roi-brand-bar">
      <img
        src="https://www.blacklinesafety.com/hubfs/Blacklinesafety_2021/images/Logo_color.svg"
        alt="Blackline Safety logo"
        class="roi-logo"
      />
    </div>

    <div class="roi-title-bar">
      <h1>G8 ROI Calculator</h1>
    </div>

    <p class="intro">
      <strong>Measure your savings</strong><br />
      Enter a few values to start. Every field is flexible and can be changed anytime. We'll show savings, Year&nbsp;1 ROI,
      and payback across conservative, typical, and high-value scenarios.
    </p>

    <div class="reset-row">
      <button type="button" id="reset_baseline_btn">Reset to baseline values</button>
      <span class="reset-help">
        Resets all inputs back to the original baseline values shown when the calculator first loaded.
      </span>
    </div>

    <div class="currency-row">
      <label for="currency_select">Currency:</label>
      <select id="currency_select">
        <option value="CAD" selected>CAD (Canadian Dollar)</option>
        <option value="USD">USD (US Dollar)</option>
        <option value="EUR">EUR (Euro)</option>
        <option value="GBP">GBP (Pound Sterling)</option>
        <option value="AUD">AUD (Australian Dollar)</option>
      </select>

      <span class="info-wrap">
        <button
          type="button"
          class="info-icon-btn"
          id="currency_info_btn"
          aria-label="Pricing and currency information"
          aria-expanded="false"
          aria-controls="currency_info_popover"
        >
          <span class="info-glyph" aria-hidden="true">i</span>
        </button>

        <div class="info-popover" id="currency_info_popover" role="dialog" aria-hidden="true">
          <div class="popover-section">
            <div class="popover-title">Pricing guidance</div>
            <p class="popover-body">
              All monetary inputs and results use the selected currency. Always pull G8 pricing from the price list based on the
              customer’s configuration and enter the applicable values into the fields below.
            </p>
          </div>
        </div>
      </span>
    </div>

    <div class="currency-helper">
      All values are shown in the selected currency.
    </div>

    <!-- Customer Inputs -->
    <h2>Customer Inputs</h2>
    <div class="section-card">
      <div class="section-note">Edit the fields below to reflect your deployment.</div>

      <div class="inputs-grid">
        <label for="num_workers">
          <span class="label-with-info">
            Number of devices to be replaced/purchased
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="num_workers_info_btn"
                aria-label="Number of devices information"
                aria-expanded="false"
                aria-controls="num_workers_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="num_workers_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Number of devices to be replaced or purchased</div>
                  <p class="popover-body">
                    The number of devices the customer plans to buy.
                  </p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="num_workers" value="100" min="0" step="1" />

        <label for="hourly_cost">
          <span class="label-with-info">
            Average hourly labour cost (per hour)
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="hourly_cost_info_btn"
                aria-label="Average hourly labour cost information"
                aria-expanded="false"
                aria-controls="hourly_cost_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="hourly_cost_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Average hourly labor cost</div>
                  <p class="popover-body">The estimated hourly cost of a field worker, based on wages or salary.</p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="hourly_cost" value="55" min="0" step="0.01" />

        <!-- G8 pricing moved higher -->
        <label for="hardware_cost">
          <span class="label-with-info">
            G8 hardware price per device (Year 1)
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="g8_hw_info_btn"
                aria-label="G8 hardware configuration information"
                aria-expanded="false"
                aria-controls="g8_hw_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="g8_hw_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Pricing guidance</div>
                  <p class="popover-body">
                    Default configuration is set as 4 gas sensor (H2S, LEL MPS, CO and O2) on a 2 year warranty.
                  </p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="hardware_cost" value="1117" min="0" step="0.01" />

        <label for="subscription_cost">
          <span class="label-with-info">
            G8 Pro Plan price per device (annual)
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="g8_plan_info_btn"
                aria-label="G8 service plan information"
                aria-expanded="false"
                aria-controls="g8_plan_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="g8_plan_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Pricing guidance</div>
                  <p class="popover-body">This is set as PRO service plan.</p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="subscription_cost" value="768" min="0" step="0.01" />

        <!-- Legacy device costs -->
        <label for="cost_radio">
          <span class="label-with-info">
            Annual price of one radio and any associated subscription
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="radio_info_btn"
                aria-label="Radio pricing information"
                aria-expanded="false"
                aria-controls="radio_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="radio_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Baseline</div>
                  <p class="popover-body">Motorola DP4801 EX</p>
                </div>
                <div class="popover-section">
                  <div class="popover-title">Update for customer</div>
                  <p class="popover-body">Replace with the customer's current radio + subscription price.</p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="cost_radio" value="2950" min="0" step="0.01" />

        <label for="cost_legacy_detector">
          <span class="label-with-info">
            Annual price of one portable gas detector and any associated subscription
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="detector_info_btn"
                aria-label="Portable gas detector pricing information"
                aria-expanded="false"
                aria-controls="detector_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="detector_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Baseline</div>
                  <p class="popover-body">MSA Altair io4 + Complete Service Plan</p>
                </div>
                <div class="popover-section">
                  <div class="popover-title">Update for customer</div>
                  <p class="popover-body">Change the price here to reflect the customer's gas detector.</p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="cost_legacy_detector" value="1150" min="0" step="0.01" />

        <label for="cost_lone_worker">
          <span class="label-with-info">
            Annual price of one lone worker device or app and any associated subscription
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="lw_info_btn"
                aria-label="Lone worker pricing information"
                aria-expanded="false"
                aria-controls="lw_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="lw_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Baseline</div>
                  <p class="popover-body">Twig Neo</p>
                </div>
                <div class="popover-section">
                  <div class="popover-title">Update for customer</div>
                  <p class="popover-body">Change the price to reflect the customer's lone worker device or app.</p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <input class="green-input" type="number" id="cost_lone_worker" value="700" min="0" step="0.01" />

        <!-- Coverage sliders -->
        <label for="radio_coverage">
          <span class="label-with-info">
            Radio replacement coverage (%)
            <span class="info-wrap">
              <button
                type="button"
                class="info-icon-btn"
                id="radio_coverage_info_btn"
                aria-label="Radio replacement coverage information"
                aria-expanded="false"
                aria-controls="radio_coverage_info_popover"
              >
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="radio_coverage_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Radio replacement coverage</div>
                  <p class="popover-body">
                    The percentage of purchased G8 devices that will replace a radio in your deployment.
                  </p>
                </div>
              </div>
            </span>
          </span>
        </label>
        <div class="slider-row">
          <input class="slider" type="range" id="radio_coverage" min="0" max="100" step="5" value="60" />
          <span class="slider-value" id="radio_coverage_value">60%</span>
        </div>

        <label for="detector_coverage">
