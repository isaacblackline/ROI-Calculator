        <td id="roi_typical"></td>
        <td id="roi_high"></td>
      </tr>

      <tr>
        <th scope="row">
          <span class="label-with-info">
            Payback period (months)
            <span class="info-wrap">
              <button type="button" class="info-icon-btn" id="payback_info_btn"
                      aria-label="Payback period formula information" aria-expanded="false" aria-controls="payback_info_popover">
                <span class="info-glyph" aria-hidden="true">i</span>
              </button>
              <div class="info-popover" id="payback_info_popover" role="dialog" aria-hidden="true">
                <div class="popover-section">
                  <div class="popover-title">Payback period formula</div>
                  <p class="popover-body">Payback period (months) = 12 × Total Year 1 G8 cost / Total annual savings</p>
                </div>
              </div>
            </span>
          </span>
        </th>
        <td id="payback_conservative"></td>
        <td id="payback_typical"></td>
        <td id="payback_high"></td>
      </tr>
      </tbody>
    </table>

    <div class="disclaimer-row">
      <button
        type="button"
        class="disclaimer-btn"
        id="disclaimer_btn"
        aria-expanded="false"
        aria-controls="disclaimer_panel"
      >
        Disclaimer
      </button>

      <div class="disclaimer-panel" id="disclaimer_panel" hidden>
        <p class="small-text" style="margin:0;">
          This calculator provides directional estimates only. Actual results will vary based on your
          specific operations, configuration, and pricing. Use it to frame discussions and compare scenarios, not as a
          guarantee of future performance.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var currentCurrency = 'USD';

  var currencyInfoMap = {
    USD: { code: 'USD', symbol: '$' },
    CAD: { code: 'CAD', symbol: '$' },
    EUR: { code: 'EUR', symbol: '€' },
    GBP: { code: 'GBP', symbol: '£' },
    AUD: { code: 'AUD', symbol: '$' }
  };

  function getCurrencyInfo() {
    return currencyInfoMap[currentCurrency] || currencyInfoMap.USD;
  }

  function updateZeroTips() {
    var info = getCurrencyInfo();
    var zeroText = (info.symbol || '$') + '0';

    var nodes = document.querySelectorAll('.currency-zero');
    nodes.forEach(function (node) {
      node.textContent = zeroText;
    });

    // Update the hard-coded example currency token (184) inside Gas details
    var ex184 = document.getElementById('gas_example_currency_184');
    if (ex184) ex184.textContent = (info.symbol || '$') + '184';
  }

  function updateCurrencyLabels() {
    var code = currentCurrency;

    var hourlyText = document.getElementById('label_hourly_cost_text');
    if (hourlyText) hourlyText.textContent = 'Average hourly labour cost (' + code + '/hr)';

    var radioText = document.getElementById('label_cost_radio_text');
    if (radioText) radioText.textContent = 'Annual price of one radio and any associated subscription (' + code + ')';

    var detectorText = document.getElementById('label_cost_legacy_detector_text');
    if (detectorText) detectorText.textContent = 'Annual price of one portable gas detector and any associated subscription (' + code + ')';

    var lwText = document.getElementById('label_cost_lone_worker_text');
    if (lwText) lwText.textContent = 'Annual price of one lone worker device or app and any associated subscription (' + code + ')';

    var label = document.getElementById('label_gas_savings');
    if (label) label.textContent = 'Calibration gas savings per device per year (' + code + ')';

    label = document.getElementById('label_addon_ptt');
    if (label) label.textContent = 'Push-to-Talk add-on per device (annual, ' + code + ')';

    label = document.getElementById('label_addon_monitoring');
    if (label) label.textContent = 'Blackline Safety Monitoring (24/7 by expert team) per device (annual, ' + code + ')';

    label = document.getElementById('label_addon_emergency_voice');
    if (label) label.textContent = 'Emergency Voice per device (annual, ' + code + ')';

    updateZeroTips();
  }

  function parseNumber(id) {
    var el = document.getElementById(id);
    if (!el) return 0;
    var raw = String(el.value).replace(/,/g, '').trim();
    var n = parseFloat(raw);
    return isNaN(n) ? 0 : n;
  }

  function setValue(id, value) {
    var el = document.getElementById(id);
    if (el) el.value = value;
  }

  function formatCurrency(value) {
    var info = getCurrencyInfo();
    return info.symbol + value.toLocaleString(undefined, { maximumFractionDigits: 0 }) + ' ' + info.code;
  }

  function formatPercent(value) {
    return (value * 100).toLocaleString(undefined, { maximumFractionDigits: 1 }) + '%';
  }

  function formatMonths(value) {
    return value.toLocaleString(undefined, { maximumFractionDigits: 1 });
  }

  function setText(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  /* ─────────────────────────────────────────────────────────────
     G8 pricing by currency (ONLY these 5 fields auto-update)
     - USD values are captured from the current baseline on load
     - Provided table is applied for AUD/CAD/EUR/GBP
     ───────────────────────────────────────────────────────────── */
  var g8PricingByCurrency = {
    AUD: { hardware_cost: 1200, subscription_cost: 984, addon_ptt: 576, addon_monitoring: 864, addon_emergency_voice: 744 },
    CAD: { hardware_cost: 1117, subscription_cost: 768, addon_ptt: 456, addon_monitoring: 552, addon_emergency_voice: 600 },
    EUR: { hardware_cost:  789, subscription_cost: 648, addon_ptt: 312, addon_monitoring: 408, addon_emergency_voice: 432 },
    GBP: { hardware_cost:  596, subscription_cost: 576, addon_ptt: 264, addon_monitoring: 312, addon_emergency_voice: 360 }
  };
  var g8UsdBaseline = null;

  function captureUsdBaselineOnce() {
    if (g8UsdBaseline) return;
    g8UsdBaseline = {
      hardware_cost: parseNumber('hardware_cost'),
      subscription_cost: parseNumber('subscription_cost'),
      addon_ptt: parseNumber('addon_ptt'),
      addon_monitoring: parseNumber('addon_monitoring'),
      addon_emergency_voice: parseNumber('addon_emergency_voice')
    };
  }

  function applyG8PricingForCurrency(code) {
    captureUsdBaselineOnce();

    if (code === 'USD') {
      if (g8UsdBaseline) {
        setValue('hardware_cost', g8UsdBaseline.hardware_cost);
        setValue('subscription_cost', g8UsdBaseline.subscription_cost);
        setValue('addon_ptt', g8UsdBaseline.addon_ptt);
        setValue('addon_monitoring', g8UsdBaseline.addon_monitoring);
        setValue('addon_emergency_voice', g8UsdBaseline.addon_emergency_voice);
      }
      return;
    }

    var cfg = g8PricingByCurrency[code];
    if (!cfg) return;

    setValue('hardware_cost', cfg.hardware_cost);
    setValue('subscription_cost', cfg.subscription_cost);
    setValue('addon_ptt', cfg.addon_ptt);
    setValue('addon_monitoring', cfg.addon_monitoring);
    setValue('addon_emergency_voice', cfg.addon_emergency_voice);
  }

  function setSliderValue(sliderId, valueId) {
    var slider = document.getElementById(sliderId);
    var valueEl = document.getElementById(valueId);
    if (!slider || !valueEl) return;
    valueEl.textContent = String(slider.value) + '%';
  }

  function setSliderFill(sliderId) {
    var slider = document.getElementById(sliderId);
    if (!slider) return;
    var v = parseFloat(slider.value);
    if (isNaN(v)) v = 0;
    slider.style.setProperty('--pct', v + '%');
  }

  function recalc() {
    var numDevices      = parseNumber('num_workers');
    var hourlyCost      = parseNumber('hourly_cost');
    var costRadio       = parseNumber('cost_radio');
    var costDetector    = parseNumber('cost_legacy_detector');
    var hwCost          = parseNumber('hardware_cost');
    var planCost        = parseNumber('subscription_cost');
    var costLW          = parseNumber('cost_lone_worker');
    var workdaysPerYear = parseNumber('workdays_per_year');
    var weeksPerYear    = parseNumber('weeks_per_year');
    var otherCosts      = parseNumber('other_annual_costs');

    var addonPTT            = parseNumber('addon_ptt');
    var addonMonitoring     = parseNumber('addon_monitoring');
    var addonEmergencyVoice = parseNumber('addon_emergency_voice');

    var pctReplaceRadio    = Math.max(0, Math.min(100, parseNumber('pct_replace_radio'))) / 100;
    var pctReplaceDetector = Math.max(0, Math.min(100, parseNumber('pct_replace_detector'))) / 100;
    var pctReplaceLW       = Math.max(0, Math.min(100, parseNumber('pct_replace_lw'))) / 100;

    var scenarios = {
      conservative: {
        minutesPerDay:       parseNumber('minutes_saved_conservative'),
        adminMinutesPerWeek: parseNumber('admin_minutes_week_conservative'),
        gasSavings:          parseNumber('gas_savings_conservative')
      },
      typical: {
        minutesPerDay:       parseNumber('minutes_saved_typical'),
        adminMinutesPerWeek: parseNumber('admin_minutes_week_typical'),
        gasSavings:          parseNumber('gas_savings_typical')
      },
      high: {
        minutesPerDay:       parseNumber('minutes_saved_high'),
        adminMinutesPerWeek: parseNumber('admin_minutes_week_high'),
        gasSavings:          parseNumber('gas_savings_high')
      }
    };

    // Coverage-adjusted consolidation savings
    var deviceConsolidation = numDevices * (
      (costRadio    * pctReplaceRadio) +
      (costDetector * pctReplaceDetector) +
      (costLW       * pctReplaceLW)
    );

    // Total Year 1 G8 cost (auto-updated per currency for G8 costs only)
    var totalYear1G8Cost = numDevices * (hwCost + planCost + addonPTT + addonMonitoring + addonEmergencyVoice) + otherCosts;

    Object.keys(scenarios).forEach(function (key) {
      var s = scenarios[key];

      var workerTimeSavings = numDevices * (s.minutesPerDay / 60) * workdaysPerYear * hourlyCost;
      var adminSavings      = numDevices * (s.adminMinutesPerWeek / 60) * weeksPerYear * hourlyCost;
      var gasSavings        = numDevices * s.gasSavings;

      var totalSavings = workerTimeSavings + adminSavings + gasSavings + deviceConsolidation;

      // show N/A instead of misleading 0% / 0 months on division-by-zero edges
      var roiDisplay     = totalYear1G8Cost === 0 ? 'N/A' : formatPercent(totalSavings / totalYear1G8Cost);
      var paybackDisplay = totalSavings === 0      ? 'N/A' : formatMonths(12 * totalYear1G8Cost / totalSavings);

      var suffix = '_' + key;

      setText('workerTime'    + suffix, formatCurrency(workerTimeSavings));
      setText('adminSavings'  + suffix, formatCurrency(adminSavings));
      setText('gasSavings'    + suffix, formatCurrency(gasSavings));
      setText('deviceSavings' + suffix, formatCurrency(deviceConsolidation));
      setText('totalSavings'  + suffix, formatCurrency(totalSavings));
      setText('totalCost'     + suffix, formatCurrency(totalYear1G8Cost));
      setText('roi'           + suffix, roiDisplay);
      setText('payback'       + suffix, paybackDisplay);
    });
  }

  /* ── Popover registry & helpers ── */
  var popoverRegistry = [];

  function closeAllPopovers(exceptPopoverEl) {
    popoverRegistry.forEach(function (item) {
      if (item.pop !== exceptPopoverEl) {
        item.pop.setAttribute('aria-hidden', 'true');
        item.btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function setupPopover(btnId, popoverId) {
    var btn = document.getElementById(btnId);
    var pop = document.getElementById(popoverId);
    if (!btn || !pop) return;

    popoverRegistry.push({ btn: btn, pop: pop });

    function closePopover() {
      pop.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
    }

    function openPopover() {
      closeAllPopovers(pop);
      pop.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var isHidden = pop.getAttribute('aria-hidden') !== 'false';
      if (isHidden) openPopover(); else closePopover();
    });

    document.addEventListener('click', function (e) {
      if (!pop.contains(e.target) && e.target !== btn) closePopover();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePopover();
    });
  }

  /* ── Tabs (works for any container id, not just popovers) ── */
  function setupPopoverTabs(containerId) {
    var container = document.getElementById(containerId);
    if (!container) return;

    var tabButtons = container.querySelectorAll('.popover-tab-btn');
    var panels     = container.querySelectorAll('.popover-tab-panel');
    if (!tabButtons.length || !panels.length) return;

    function activateTab(btn) {
      var targetId = btn.getAttribute('aria-controls');

      tabButtons.forEach(function (b) {
        var active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach(function (p) {
        if (p.id === targetId) p.removeAttribute('hidden');
        else                   p.setAttribute('hidden', '');
      });
    }

    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        activateTab(btn);
      });

      btn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateTab(btn);
        }
      });
    });
  }

  /* ── Inline details toggles (Option 2 for Admin + Gas) ── */
  function setupInlineDetails(openBtnId, closeBtnId, rowId, popoverId, popoverBtnId) {
    var openBtn  = document.getElementById(openBtnId);
    var closeBtn = document.getElementById(closeBtnId);
    var row      = document.getElementById(rowId);
    var pop      = document.getElementById(popoverId);
    var popBtn   = document.getElementById(popoverBtnId);

    if (!openBtn || !closeBtn || !row) return;

    function openRow() {
      row.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      // close the popover if it exists
      if (pop && popBtn) {
        pop.setAttribute('aria-hidden', 'true');
        popBtn.setAttribute('aria-expanded', 'false');
      }
      row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function closeRow() {
      row.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
    }

    openBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (row.hidden) openRow();
      else closeRow();
    });

    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      closeRow();
    });
  }

  /* ── Disclaimer toggle ── */
  function setupDisclaimerToggle(btnId, panelId) {
    var btn   = document.getElementById(btnId);
    var panel = document.getElementById(panelId);
    if (!btn || !panel) return;

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var isOpen = !panel.hidden;
      if (isOpen) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      } else {
        closeAllPopovers(null);
        panel.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', function (e) {
      if (!panel.contains(e.target) && e.target !== btn) {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        panel.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function setupSlider(sliderId, valueId) {
    var slider = document.getElementById(sliderId);
    if (!slider) return;

    setSliderValue(sliderId, valueId);
    setSliderFill(sliderId);

    slider.addEventListener('input', function () {
      setSliderValue(sliderId, valueId);
      setSliderFill(sliderId);
      recalc();
    });
  }

  /* ── Bootstrap ── */
  document.addEventListener('DOMContentLoaded', function () {
    // Capture baseline values (for reset)
    var baselineValues = {};
    var inputs = document.querySelectorAll('input');

    inputs.forEach(function (input) {
      if (input.id) baselineValues[input.id] = input.value;

      if (input.type !== 'range') {
        input.addEventListener('input', recalc);
      }
    });

    // Capture USD baseline for G8 pricing fields (so switching back to USD restores these)
    captureUsdBaselineOnce();

    // Reset button
    var resetBtn = document.getElementById('reset_baseline_btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        Object.keys(baselineValues).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.value = baselineValues[id];
        });

        // re-sync slider pills + fills
        setSliderValue('pct_replace_radio', 'pct_replace_radio_value');
        setSliderValue('pct_replace_detector', 'pct_replace_detector_value');
        setSliderValue('pct_replace_lw', 'pct_replace_lw_value');
        setSliderFill('pct_replace_radio');
        setSliderFill('pct_replace_detector');
        setSliderFill('pct_replace_lw');

        // If currency is not USD, re-apply currency-specific G8 pricing (as per your requirement)
        applyG8PricingForCurrency(currentCurrency);

        recalc();
      });
    }

    // Currency selector
    var currencySelect = document.getElementById('currency_select');
    if (currencySelect) {
      currentCurrency = currencySelect.value || 'USD';

      // Apply G8 pricing for the initial currency selection (USD keeps baseline; others snap to table)
      applyG8PricingForCurrency(currentCurrency);

      currencySelect.addEventListener('change', function () {
        currentCurrency = this.value || 'USD';

        // Update labels
        updateCurrencyLabels();

        // Auto-update ONLY the G8 costs to the table values for that currency
        applyG8PricingForCurrency(currentCurrency);

        // Recalc after changes
        recalc();
      });
    }

    /* wire up every popover */
    setupPopover('currency_info_btn',             'currency_info_popover');
    setupPopover('num_workers_info_btn',          'num_workers_info_popover');
    setupPopover('hourly_cost_info_btn',          'hourly_cost_info_popover');
    setupPopover('g8_hw_info_btn',                'g8_hw_info_popover');
    setupPopover('g8_plan_info_btn',              'g8_plan_info_popover');
    setupPopover('radio_info_btn',                'radio_info_popover');
    setupPopover('detector_info_btn',             'detector_info_popover');
    setupPopover('lw_info_btn',                   'lw_info_popover');

    setupPopover('pct_replace_radio_info_btn',    'pct_replace_radio_info_popover');
    setupPopover('pct_replace_detector_info_btn', 'pct_replace_detector_info_popover');
    setupPopover('pct_replace_lw_info_btn',       'pct_replace_lw_info_popover');

    setupPopover('other_costs_info_btn',          'other_costs_info_popover');
    setupPopover('minutes_saved_info_btn',        'minutes_saved_info_popover');

    setupPopover('admin_minutes_week_info_btn',   'admin_minutes_week_info_popover');
    setupPopover('gas_savings_info_btn',          'gas_savings_info_popover');

    setupPopover('device_savings_info_btn',       'device_savings_info_popover');
    setupPopover('total_cost_info_btn',           'total_cost_info_popover');
    setupPopover('roi_info_btn',                  'roi_info_popover');
    setupPopover('payback_info_btn',              'payback_info_popover');

    /* OPTION 2: tabs now live in inline details panels */
    setupPopoverTabs('admin_details_panel');
    setupPopoverTabs('gas_details_panel');

    /* OPTION 2: inline details toggles */
    setupInlineDetails('admin_details_open_btn', 'admin_details_close_btn', 'admin_details_row', 'admin_minutes_week_info_popover', 'admin_minutes_week_info_btn');
    setupInlineDetails('gas_details_open_btn',   'gas_details_close_btn',   'gas_details_row',   'gas_savings_info_popover',        'gas_savings_info_btn');

    /* disclaimer */
    setupDisclaimerToggle('disclaimer_btn', 'disclaimer_panel');

    /* sliders */
    setupSlider('pct_replace_radio', 'pct_replace_radio_value');
    setupSlider('pct_replace_detector', 'pct_replace_detector_value');
    setupSlider('pct_replace_lw', 'pct_replace_lw_value');

    /* initial render */
    updateCurrencyLabels();
    recalc();
  });
})();
</script>
</body>
</html>
